# Copy to .env.local (never commit .env.local). Use npm run setup for an interactive file.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web Push (VAPID) — public key is safe in the client bundle
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private VAPID key and subject — server / Edge Function only (not NEXT_PUBLIC_)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Canonical origin for notification URLs and absolute icon paths in Edge
SITE_URL=https://your-app.example.com

# Shared secret: Database Webhook sends header x-webhook-secret; Edge function verifies
WEBHOOK_SECRET=

# Docker production build (build-args; optional if you inject at runtime another way)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
