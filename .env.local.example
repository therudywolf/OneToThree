# Copy to client/.env.local (never commit .env.local)

# Fastify API origin (no trailing slash); browser sends cookies to this host.
NEXT_PUBLIC_API_URL=http://localhost:8080

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

SITE_URL=http://localhost:3000
WEBHOOK_SECRET=
