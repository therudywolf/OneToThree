# =============================================================================
# OneToThree (Forest Messenger) — Production Environment
# =============================================================================
#
#  Этот файл создаётся и заполняется автоматически при первом ./start.sh
#  Ручное редактирование НЕ требуется — все значения генерируются и
#  синхронизируются из ./secrets/ скриптом start.sh.
#
#  ИСПОЛЬЗОВАНИЕ:
#    ./start.sh          — генерирует секреты, заполняет .env.prod, запускает стек
#    ./start.sh clean    — удаляет volumes и секреты для свежего деплоя
#
# =============================================================================


# =============================================================================
# 1. БАЗА ДАННЫХ
# =============================================================================

POSTGRES_USER=forest
POSTGRES_PASSWORD=                      # авто-заполняется из ./secrets/

POSTGRES_DB=forest

# Заполняется автоматически из POSTGRES_* при ./start.sh
DATABASE_URL=postgres://forest:CHANGE_ME@db:5432/forest


# =============================================================================
# 2. СЕКРЕТЫ ПРИЛОЖЕНИЯ
# =============================================================================
# Генерируются автоматически при первом ./start.sh
# Для мульти-инстанс деплоя — установите вручную одинаковые значения на всех нодах

JWT_SECRET=                             # авто-генерация (min 32 chars; generate with: openssl rand -hex 32)
WEBHOOK_SECRET=                         # авто-генерация
TOTP_WRAP_KEY=                          # авто-генерация (32 bytes hex; AES-256-GCM для шифрования TOTP секретов в БД)


# =============================================================================
# 3. ДОМЕН (обязательно — читается Caddyfile и docker-compose через {$DOMAIN})
# =============================================================================

# Базовый домен без протокола и слэша.
# Устанавливается автоматически при ./start.sh из secrets/domain.
# Используется Caddyfile ({$DOMAIN}) для автоматического TLS и маршрутизации.
DOMAIN=onetothree.ru                     # авто-заполняется из ./secrets/domain


# =============================================================================
# 4. ХРАНИЛИЩЕ ФАЙЛОВ (MinIO / S3)
# =============================================================================

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=                    # авто-заполняется из ./secrets/

MINIO_BUCKET=onetothree-media

# Внутренний URL для API-контейнера (Docker internal — не менять)
MINIO_ENDPOINT=http://minio:9000

# Публичный URL для браузера (presigned upload/download)
MINIO_PUBLIC_URL=https://s3.onetothree.ru   # авто-заполняется по домену

# Разрешённые origins для CORS при загрузке файлов (через запятую)
MINIO_CORS_ORIGINS=https://onetothree.ru,https://www.onetothree.ru   # авто-заполняется по домену


# =============================================================================
# 5. СЕТЬ И CORS
# =============================================================================

# Разрешённые origins браузера (без слэша в конце)
CORS_ORIGIN=https://onetothree.ru       # авто-заполняется из ./secrets/

# 1 — если стоит за Caddy/nginx (реальные IP в логах и rate limit)
TRUST_PROXY=1

# Общая cookie-сессия между apex и api.* (нужна если API на отдельном субдомене)
COOKIE_DOMAIN=.onetothree.ru           # авто-заполняется по домену

# Email для Let's Encrypt ACME уведомлений (истечение сертификата и т.д.)
ACME_EMAIL=admin@onetothree.ru          # авто-заполняется из ./secrets/

# Публичные URL (должны совпадать с Caddyfile и DNS)
NEXT_PUBLIC_API_URL=https://api.onetothree.ru    # авто-заполняется по домену
NEXT_PUBLIC_APP_URL=https://onetothree.ru        # публичный web/PWA origin для QR-ссылок
NEXT_PUBLIC_WS_ORIGIN=https://api.onetothree.ru  # авто-заполняется по домену
NEXT_PUBLIC_GIPHY_API_KEY=                        # production GIF provider key (required for trending/search)


# =============================================================================
# 6. WEBRTC / TURN СЕРВЕР
# =============================================================================
#
#  ВАЖНО — Cloudflare:
#    DNS-запись turn.ваш-домен.ru ОБЯЗАТЕЛЬНО должна быть "DNS only" (серое облако).
#    Оранжевое облако (Proxied) блокирует UDP — звонки перестанут работать.
#    api.* и apex могут оставаться под проксированием (оранжевые).
#    Fallback turns:*:443 обычно поднимается на отдельном TURN-host/IP (не на том же :443, где сайт через Caddy).
#
#  Откройте порты на сервере:
#    ufw allow 3478/tcp
#    ufw allow 3478/udp
#    ufw allow 49152:65535/udp
#

# Публичный IP этого сервера (для coturn NAT traversal)
TURN_EXTERNAL_IP=                       # авто-заполняется из ./secrets/

# Логин и пароль TURN (сервер и браузер должны совпадать)
TURN_USERNAME=turn
TURN_PASSWORD=                          # авто-заполняется из ./secrets/

# URL TURN для браузера — ОБЯЗАТЕЛЬНО отдельный hostname без Cloudflare proxy
# Указывайте цепочку фолбеков (UDP/TCP/TLS). Пример:
# NEXT_PUBLIC_TURN_URLS=turn:turn.onetothree.ru:3478,turn:turn.onetothree.ru:3478?transport=tcp,turns:turn.onetothree.ru:443?transport=tcp,turns:turn.onetothree.ru:5349?transport=tcp
NEXT_PUBLIC_TURN_URL=turn:turn.onetothree.ru:3478   # back-compat, авто-заполняется по домену
NEXT_PUBLIC_TURN_URLS=                              # авто-заполняется по домену (recommended)
NEXT_PUBLIC_TURN_USERNAME=turn                       # авто-синхронизация из TURN_USERNAME
NEXT_PUBLIC_TURN_PASSWORD=                           # авто-синхронизация из TURN_PASSWORD

# Серверная версия списка TURN URL (если пусто, будет взят NEXT_PUBLIC_TURN_URLS)
TURN_URLS=


# =============================================================================
# 7. PUSH-УВЕДОМЛЕНИЯ (VAPID)
# =============================================================================
#
#  Генерируются автоматически при ./start.sh
#  Вручную: npx web-push generate-vapid-keys

VAPID_PUBLIC_KEY=                       # авто-генерация
NEXT_PUBLIC_VAPID_PUBLIC_KEY=           # авто-генерация (копия VAPID_PUBLIC_KEY)
VAPID_PRIVATE_KEY=                      # авто-генерация — никому не передавать

VAPID_SUBJECT=mailto:admin@onetothree.ru  # авто-заполняется из ./secrets/


# =============================================================================
# 8. LIVEKIT SFU (опционально — групповые/медиа-звонки через сервер)
# =============================================================================
#
# Если livekit-сервис включён в docker-compose.prod.yml, URL и ключи
# авто-заполняются скриптом start.sh по домену.
# Формат: wss://lk.ВАШ_ДОМЕН
#
LIVEKIT_URL=                             # авто-заполняется: wss://lk.${DOMAIN}
LIVEKIT_API_KEY=                         # авто-генерация
LIVEKIT_API_SECRET=                      # авто-генерация — никому не передавать


# =============================================================================
# 9. ДОПОЛНИТЕЛЬНО (опционально, раскомментировать при необходимости)
# =============================================================================

# Время хранения медиафайлов в секундах (0 = хранить вечно)
# MEDIA_RETENTION_SECONDS=604800        # 7 дней

# Redis для мульти-инстанс деплоя (QR токены между нодами)
# REDIS_URL=redis://redis:6379

# Токен первого администратора (только первый запуск — удалить после использования)
# ADMIN_BOOTSTRAP_TOKEN=

# URL сайта для ссылок в уведомлениях
# SITE_URL=https://onetothree.ru


# =============================================================================
# 10. КЛАСТЕР / MESH (под будущий scale-out)
# =============================================================================
#
# Генерируются автоматически при ./start.sh и пригодятся для role-based mesh:
# - helper API ноды
# - worker ноды
# - replica / backup automation

CLUSTER_JOIN_TOKEN=                    # авто-генерация
INTERNAL_API_SIGNING_KEY=              # авто-генерация
BACKUP_ENCRYPTION_KEY=                 # авто-генерация
