# =============================================================================
# OneToThree (Forest Messenger) — Production Environment
# =============================================================================
# Usage: cp .env.prod.example .env.prod
# Then: ./setup.sh
#
# Sections:
#   1. Database
#   2. Application secrets
#   3. Object storage (MinIO/S3)
#   4. Network & CORS
#   5. WebRTC / TURN
#   6. Web Push (VAPID)
#   7. Optional knobs
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE
# -----------------------------------------------------------------------------
POSTGRES_USER=forest
POSTGRES_PASSWORD=                        # REQUIRED — strong random password
POSTGRES_DB=forest

# Full connection string for the API container (matches user/password/db above)
DATABASE_URL=postgres://forest:CHANGE_ME@db:5432/forest

# -----------------------------------------------------------------------------
# 2. APPLICATION SECRETS
# -----------------------------------------------------------------------------
# Auto-generated by setup.sh if empty. Set manually for multi-instance deploys.
JWT_SECRET=                               # REQUIRED — min 64 hex chars (openssl rand -hex 32)
WEBHOOK_SECRET=                           # REQUIRED — min 64 hex chars (openssl rand -hex 32)

# -----------------------------------------------------------------------------
# 3. OBJECT STORAGE (MinIO / S3-compatible)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=                      # REQUIRED — strong random password
MINIO_BUCKET=onetothree-media

# Internal Docker URL for the API container
MINIO_ENDPOINT=http://minio:9000

# Public browser-reachable URL for presigned PUT/GET
MINIO_PUBLIC_URL=https://s3.onetothree.ru # REQUIRED — set to your S3 subdomain

# Allowed CORS origins for presigned uploads (comma-separated)
MINIO_CORS_ORIGINS=https://onetothree.ru,https://www.onetothree.ru

# -----------------------------------------------------------------------------
# 4. NETWORK & CORS
# -----------------------------------------------------------------------------
# Allowed browser origins (comma-separated, no trailing slash)
CORS_ORIGIN=https://onetothree.ru         # REQUIRED

# Set to 1 behind Caddy/nginx so rate limits and logs see real IPs
TRUST_PROXY=1

# Share session cookie between apex and api.* subdomain
COOKIE_DOMAIN=.onetothree.ru             # REQUIRED if API is on a different subdomain

# Public URLs (must match Caddyfile / DNS)
NEXT_PUBLIC_API_URL=https://api.onetothree.ru
NEXT_PUBLIC_WS_ORIGIN=https://api.onetothree.ru

# Internal URL the Next.js container uses for SSR API calls (optional, defaults to NEXT_PUBLIC_API_URL)
# INTERNAL_API_URL=http://api:8080

# -----------------------------------------------------------------------------
# 5. WEBRTC / TURN SERVER
# -----------------------------------------------------------------------------
# CLOUDFLARE NOTE:
#   - turn.onetothree.ru MUST be "DNS only" (gray cloud) in Cloudflare — orange proxy
#     blocks UDP/TCP traffic that TURN needs. WebRTC calls will fail if proxied.
#   - api.* and the apex CAN stay proxied (orange).
#   - Firewall: open 3478/tcp, 3478/udp, 49152-65535/udp on the host.
#     Example: ufw allow 3478/tcp && ufw allow 3478/udp && ufw allow 49152:65535/udp

# Public IP of this server — used by coturn for NAT traversal
TURN_EXTERNAL_IP=                         # REQUIRED — run: curl -s ifconfig.me

# TURN server credentials (server-side, passed to coturn)
TURN_USERNAME=turn
TURN_PASSWORD=                            # REQUIRED — strong random password

# TURN server URL seen by browsers (must NOT be behind Cloudflare proxy)
NEXT_PUBLIC_TURN_URL=turn:turn.onetothree.ru:3478
NEXT_PUBLIC_TURN_USERNAME=turn
NEXT_PUBLIC_TURN_PASSWORD=                # REQUIRED — same as TURN_PASSWORD above

# -----------------------------------------------------------------------------
# 6. WEB PUSH (VAPID)
# -----------------------------------------------------------------------------
# Auto-generated by setup.sh if empty. Regenerate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=                         # Auto-generated
NEXT_PUBLIC_VAPID_PUBLIC_KEY=             # Auto-generated (must match VAPID_PUBLIC_KEY)
VAPID_PRIVATE_KEY=                        # Auto-generated — NEVER share or commit
VAPID_SUBJECT=mailto:admin@onetothree.ru  # REQUIRED — contact email for push service

# -----------------------------------------------------------------------------
# 7. OPTIONAL KNOBS
# -----------------------------------------------------------------------------
# Media retention (seconds). 0 = keep forever.
# MEDIA_RETENTION_SECONDS=604800          # 7 days

# Redis for multi-instance QR token sharing
# REDIS_URL=redis://redis:6379

# Admin bootstrap token (first-run only, remove after use)
# ADMIN_BOOTSTRAP_TOKEN=

# Site URL for links in emails/notifications
# SITE_URL=https://onetothree.ru
