# Shorter alias of `env.prod.example` (same keys). Prefer: `cp .env.prod.example .env.prod`

POSTGRES_USER=forest
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=forest

JWT_SECRET=
WEBHOOK_SECRET=

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-strong
MINIO_BUCKET=project13-media
# Internal URL for the API container (Docker). Presigned URLs use MINIO_PUBLIC_URL when set.
# MINIO_ENDPOINT=http://minio:9000
# Browser-reachable MinIO/S3 base URL for presigned PUT/GET (required when MINIO_ENDPOINT is internal).
MINIO_PUBLIC_URL=https://s3.onetothree.ru
# Comma-separated origins for MinIO bucket CORS (browser PUT to presigned URLs). Defaults to CORS_ORIGIN when unset.
# MINIO_CORS_ORIGINS=https://onetothree.ru,https://api.onetothree.ru

CORS_ORIGIN=https://onetothree.ru
TRUST_PROXY=1

# Share `fm_session` between web apex and `api.*` (required if NEXT_PUBLIC_API_URL is another host).
COOKIE_DOMAIN=.onetothree.ru

NEXT_PUBLIC_API_URL=https://api.onetothree.ru
NEXT_PUBLIC_WS_ORIGIN=https://api.onetothree.ru

## WEBRTC TURN SERVER (coturn in docker-compose.prod.yml)
# Firewall: you MUST allow 3478/tcp, 3478/udp, and 49152-65535/udp on the host (e.g. ufw allow 3478/tcp; ufw allow 3478/udp; ufw allow 49152:65535/udp).
# Server-side long-term credentials (passed to coturn --user=…).
TURN_USERNAME=rudy
TURN_PASSWORD=your_secure_password
# Browser / Next.js bundle (must match TURN_* above for ICE).
NEXT_PUBLIC_TURN_URL=turn:api.onetothree.ru:3478
NEXT_PUBLIC_TURN_USERNAME=rudy
NEXT_PUBLIC_TURN_PASSWORD=your_secure_password

NEXT_PUBLIC_VAPID_PUBLIC_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@onetothree.ru

# MEDIA_RETENTION_* and other knobs: see README / MANIFEST.
