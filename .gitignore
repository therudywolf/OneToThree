# Dependencies & build outputs
node_modules/
**/node_modules/
.next/
dist/
.turbo/
out/
build/
*.tsbuildinfo
coverage/
.nyc_output/

# Environment & secrets are consolidated in the "secrets (security baseline)"
# section near the end of this file — one place, one set of template exceptions.

# Generated self-host desktop CSP override (from `npm run build:selfhost`)
desktop/tauri/tauri.selfhost.gen.json

# Generated by the Lite installer (scripts/lite/install.mjs)
infra/lite/Caddyfile
# Rendered by the Lite installer and carries the SFU's API secret — a key that
# mints a token for any room on that server.
infra/lite/livekit.yaml

# Explicit prod filenames (also covered by .env.* — listed for clarity)
.env.prod
.env.prod.old
*.env.prod*
.env.production
env.prod.example
!config/env/.env.prod.example
!config/env/.env.mesh.example

# Docker secrets (generated by startup.sh — never commit)
secrets/
secrets-backups/

# Docker DB env (contains credentials — use config/env/docker.db.env.example as template)
docker.db.env

# TLS material & host-mounted certs (never commit keys or chains)
certs/

# Docker / local volume data (if bind-mounted as dirs)
postgres_data/
minio_data/

# Local DB dumps / backup archives (never commit live data)
backups/
*.dump
*.sql.gz

# Drizzle local cache (SQL migrations and meta journal remain tracked)

# Runtime API logs (optional)
logs/

# Debug / analysis artifacts (HAR traces, screenshots — never commit)
Har/
Debug/
Screen/
*.har
*.png.tmp

# Consolidated local workspace artifacts moved out of the project root
_local/

# OS & logs
.DS_Store
Thumbs.db
*.swp
*~
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/

# Vercel / misc
.vercel
.cursor/
# Ignore local agent state (settings.local.json, worktrees/) but TRACK shared,
# reusable agent workflows (e.g. the codebase bug-hunt).
.claude/*
!.claude/workflows/
.idea/
.vscode/
*.pem
*.codex-temp.*

# PWA / next-pwa generated (regenerated on build)
**/public/sw.js
**/public/workbox-*.js
**/public/worker-*.js
**/public/fallback-*.js

# Playwright
playwright-report/
test-results/
blob-report/
**/playwright/.cache/

# Agent scratch directories
.agent-tmp/

# artifacts/ is a local build cache. releases/ contains publishable APKs.
artifacts/

