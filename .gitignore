# Dependencies & build outputs
node_modules/
**/node_modules/
.next/
dist/
.turbo/
out/
build/
*.tsbuildinfo

# Environment — never commit secrets (templates only)
.env
.env.*
!.env.example
!.env.local.example
!server/.env.example
!client/.env.local.example

# Docker / local volume data (if bind-mounted as dirs)
postgres_data/
minio_data/

# Drizzle local cache (SQL migrations remain tracked)
server/drizzle/meta/

# OS & logs
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/

# Vercel / misc
.vercel
*.pem

# PWA / next-pwa generated (regenerated on build)
**/public/sw.js
**/public/workbox-*.js
**/public/worker-*.js
**/public/fallback-*.js
