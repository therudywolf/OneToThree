# Dependencies & build outputs
node_modules/
**/node_modules/
.next/
dist/
.turbo/
out/
build/
*.tsbuildinfo
coverage/
.nyc_output/

# Environment — never commit secrets (templates only)
.env
.env.*
!.env.example
!.env.local.example
!server/.env.example
!client/.env.local.example

# Docker / local volume data (if bind-mounted as dirs)
postgres_data/
minio_data/

# Local DB dumps / backup archives (never commit live data)
backups/
*.dump

# Drizzle local cache (SQL migrations remain tracked)
server/drizzle/meta/

# Runtime API logs (optional)
logs/

# OS & logs
.DS_Store
Thumbs.db
*.swp
*~
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/

# Vercel / misc
.vercel
.cursor/
.idea/
.vscode/
*.pem

# PWA / next-pwa generated (regenerated on build)
**/public/sw.js
**/public/workbox-*.js
**/public/worker-*.js
**/public/fallback-*.js

# Playwright
playwright-report/
test-results/
blob-report/
**/playwright/.cache/
