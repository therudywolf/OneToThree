# Dependencies & build outputs
node_modules/
**/node_modules/
.next/
dist/
.turbo/
out/
build/
*.tsbuildinfo
coverage/
.nyc_output/

# Environment — never commit secrets (templates only)
.env
.env.*
!.env.prod.example
!.env.local.example
!.env.example
!server/.env.example
!client/.env.local.example
# Explicit prod filenames (also covered by .env.* — listed for clarity)
.env.prod
.env.prod.old
*.env.prod*
.env.production
env.prod.example

# Docker secrets (generated by generate-secrets.sh — never commit)
secrets/
secrets-backups/

# Docker DB env (contains credentials — use docker.db.env.example as template)
docker.db.env

# TLS material & host-mounted certs (never commit keys or chains)
certs/

# Docker / local volume data (if bind-mounted as dirs)
postgres_data/
minio_data/

# Local DB dumps / backup archives (never commit live data)
backups/
*.dump
*.sql.gz

# Drizzle local cache (SQL migrations and meta journal remain tracked)

# Runtime API logs (optional)
logs/

# Debug / analysis artifacts (HAR traces, screenshots — never commit)
Har/
Screen/
*.har
*.png.tmp

# Consolidated local workspace artifacts moved out of the project root
_local/

