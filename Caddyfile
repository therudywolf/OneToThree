# Project 13 — Caddy automatic HTTPS (Let's Encrypt / ACME).
# Certificates and account data persist in the Docker volume `caddy_data` → /data.
# Prerequisites: public DNS A/AAAA for each host below → this machine; ports 80/443 reachable.

{
	email {env.ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://cdn.jsdelivr.net; media-src 'self' blob: https://s3.onetothree.ru; connect-src 'self' wss: https: https://s3.onetothree.ru; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'"
		-Server
	}
}

onetothree.ru {
	import security_headers
	reverse_proxy web:3000
}

api.onetothree.ru {
	import security_headers
	reverse_proxy api:8080
}

s3.onetothree.ru {
	import security_headers
	reverse_proxy minio:9000
}

# TURN hostname — Caddy only holds a certificate here so the operator cron
# script (`scripts/sync-turn-certs.sh`) can copy it over to coturn for the
# turns:// listener on 5349. HTTP probes on 80/443 for this host return 404.
#
# In Cloudflare this subdomain MUST be gray-cloud (DNS only); otherwise
# UDP relay from the client will be dropped.
turn.onetothree.ru {
	tls {
		issuer acme
	}
	respond "TURN endpoint — use turn:turn.onetothree.ru:3478 or turns:turn.onetothree.ru:5349" 404
}

# LiveKit SFU signaling (WebSocket over TLS). The LiveKit server listens on
# host port 7880; Caddy terminates TLS and proxies WebSocket upgrades through.
# In Cloudflare this subdomain MUST be gray-cloud (DNS only) — SFU media is UDP.
lk.onetothree.ru {
	import security_headers
	reverse_proxy host.docker.internal:7880 {
		transport http {
			versions 1.1 2
			keepalive 2m
		}
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up Upgrade {header.Upgrade}
		header_up Connection {header.Connection}
	}
}
