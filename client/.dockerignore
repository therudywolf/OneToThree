node_modules
.next
.git
.gitignore
Dockerfile
docker-compose.yml
.dockerignore
*.md
# Never ship the bootstrapped dev env file (scripts/bootstrap.js writes
# client/.env.local) into the build context. It carried VAPID_PRIVATE_KEY /
# WEBHOOK_SECRET into the `builder` layer, and — worse — Next loads .env.local
# at a HIGHER precedence than the .env.production the Dockerfile generates from
# the build args, so the dev `NEXT_PUBLIC_API_URL=''` silently won and the
# shipped bundle pointed at the wrong API origin. The Dockerfile's guard only
# tests the ARG, so it never caught it.
.env*.local
.env.local
npm-debug.log*
yarn-error.log*
