# Copy created by: npm run setup → client/.env.local (never commit .env.local)

# Leave empty for same-origin /api (Next rewrites to Fastify — required for cookie + middleware).
# Set http://localhost:8080 only if you bypass the Next proxy (not recommended).
NEXT_PUBLIC_API_URL=

# Same public key as VAPID_PUBLIC_KEY on the server (bootstrap fills both)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private key stays local (used by scripts that regenerate push config)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

SITE_URL=http://localhost:3000
WEBHOOK_SECRET=
