# Next.js — development image (bind-mount friendly).
# Runs as root so `docker-compose` can `npm install` into named volumes / bind mounts.
# Production: use ./Dockerfile (multi-stage, non-root `nextjs` user).
FROM node:26-alpine

RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

EXPOSE 3000

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
