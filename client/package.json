{
  "name": "project-13-client",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:export": "cross-env NEXT_EXPORT=1 NEXT_PUBLIC_API_URL=https://api.onetothree.ru NEXT_PUBLIC_APP_URL=https://onetothree.ru next build --webpack",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"playwright*.ts\" --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "docker:dev": "docker compose -f ../docker-compose.yml up --build",
    "setup": "node scripts/setup.js",
    "env:local": "node scripts/write-env-local.js",
    "postinstall": "node -e \"const {cpSync,existsSync}=require('fs'),p=require('path'),s=p.join(__dirname,'node_modules','livekit-client','dist','livekit-client.e2ee.worker.js');if(existsSync(s))cpSync(s,p.join(__dirname,'public','livekit-e2ee-worker.js'));\""
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@tanstack/react-virtual": "^3.13.23",
    "browser-image-compression": "^2.0.2",
    "dexie": "^4.4.2",
    "dompurify": "^3.4.1",
    "emoji-picker-react": "^4.18.0",
    "emoji-regex": "^9.2.2",
    "framer-motion": "^11.18.2",
    "idb": "^7.1.1",
    "jsqr": "^1.4.0",
    "livekit-client": "^2.18.4",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.7",
    "pako": "^2.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-image-crop": "^11.0.10",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.19.39",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "globals": "^14.0.0",
    "next-pwa": "^5.6.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "web-push": "^3.6.7"
  },
