# =============================================================================
# OneToThree helper-node mesh environment
# =============================================================================
#
# Use this on a second server when you want it to help the main deployment as a
# dedicated TURN relay node.
#
# Usage:
#   ./startup.sh mesh
#   edit .env.mesh
#   copy secrets/turn_auth_secret from the main deployment to ./secrets/turn_auth_secret
#   ./startup.sh mesh
#
# This helper node does not run the main web/api/database stack.
# It only runs the relay role defined in docker-compose.mesh.yml.
#
# There is no TURN username/password here. Credentials are time-limited and
# signed per user by the main api with the TURN auth secret; this node only
# verifies them. The secret is a FILE (it must not sit in an env file that
# anything else reads), and it must be byte-for-byte the main host's.

TURN_REALM=onetothree.ru
TURN_EXTERNAL_IP=CHANGE_ME
