# Self-host desktop build config — copy to `.env` and point at YOUR server.
# Used by `npm run build:selfhost`. Everything defaults to the public
# onetothree.ru instance if unset, so the maintainer build needs no .env.

# Your API origin (the Fastify server, behind your reverse proxy).
OT_API_URL=https://api.your-domain.tld
# The web app origin (used for deep-links / share URLs).
OT_APP_URL=https://your-domain.tld
# Your S3/MinIO public origin (media + sticker/avatar objects).
OT_S3_URL=https://s3.your-domain.tld
# Your LiveKit (calls) websocket origin — only used when calls are enabled.
OT_LIVEKIT_URL=wss://lk.your-domain.tld

# Feature toggles — trim the CSP allow-list for what your instance actually runs.
# Disable calls if you don't run LiveKit/coturn; disable GIF to drop the
# Giphy/Tenor allow-list (no third-party GIF requests).
OT_ENABLE_CALLS=true
OT_ENABLE_GIF=true
