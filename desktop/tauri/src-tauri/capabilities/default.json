{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main OneToThree window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:path:default",
    "deep-link:default",
    "notification:default",
    {
      "identifier": "core:webview:allow-create-webview-window",
      "allow": [{ "label": "main" }]
    }
  ]
}
