# Project 13 — production (copy to .env.prod at repo root; used by setup.sh + docker-compose.prod.yml)
# Never commit .env.prod with real secrets.

POSTGRES_USER=forest
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=forest

JWT_SECRET=change-me-64-char-random

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-strong

MINIO_BUCKET=project13-media
# MINIO_BUCKET_AVATARS=project13-avatars

# Browser origins (comma-separated, no wildcards in production)
CORS_ORIGIN=https://onetothree.ru

# Behind Caddy / reverse proxy — real client IPs for logs and rate limits
TRUST_PROXY=1

# Public URLs baked into Next build args (docker-compose.prod.yml)
NEXT_PUBLIC_API_URL=https://api.onetothree.ru
NEXT_PUBLIC_WS_ORIGIN=https://api.onetothree.ru
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain

# --- MinIO / disk budget (~40–50GB class hosts) ---
# Tune retention so encrypted media + avatars stay inside your volume budget.
# Rough guide: lower MEDIA_RETENTION_DAYS if average attachment size is large.
# MEDIA_RETENTION_ENABLED=1
# MEDIA_RETENTION_DAYS=21
# MEDIA_PURGE_OFF_PEAK=1
# MEDIA_PURGE_UTC_START=1
# MEDIA_PURGE_UTC_END=6
# MEDIA_PURGE_BATCH=12
