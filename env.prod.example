# Shorter alias of `.env.prod.example` (same keys). Prefer: `cp .env.prod.example .env.prod`

POSTGRES_USER=forest
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=forest

JWT_SECRET=
WEBHOOK_SECRET=

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-strong
MINIO_BUCKET=project13-media
# Comma-separated origins for MinIO bucket CORS (browser PUT to presigned URLs). Defaults to CORS_ORIGIN when unset.
# MINIO_CORS_ORIGINS=https://onetothree.ru,https://api.onetothree.ru

CORS_ORIGIN=https://onetothree.ru
TRUST_PROXY=1

# Share `fm_session` between web apex and `api.*` (required if NEXT_PUBLIC_API_URL is another host).
COOKIE_DOMAIN=.onetothree.ru

NEXT_PUBLIC_API_URL=https://api.onetothree.ru
NEXT_PUBLIC_WS_ORIGIN=https://api.onetothree.ru
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@onetothree.ru

# MEDIA_RETENTION_* and other knobs: see README / MANIFEST.
