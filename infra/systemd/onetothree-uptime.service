[Unit]
Description=OneToThree uptime probe
Documentation=https://github.com/therudywolf/OneToThree/blob/main/docs/OPS.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/sites/onetothree.ru
EnvironmentFile=-%h/sites/onetothree.ru/.env.uptime
ExecStart=/bin/bash %h/sites/onetothree.ru/scripts/uptime-check.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=2min
