<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App-sandboxed dirs only. `external-path path="."` used to map the WHOLE
         shared-storage tree (/sdcard), so any FileProvider content:// URI the app
         built could grant a read on arbitrary external files. Scope to the app's
         own external-files / cache dirs so grants can never escape the sandbox (#15). -->
    <external-files-path name="my_images" path="." />
    <external-cache-path name="my_ext_cache" path="." />
    <cache-path name="my_cache_images" path="." />
    <files-path name="my_files" path="." />
</paths>
