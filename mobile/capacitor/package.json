{
  "name": "onetothree-capacitor-android",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor Android + iOS shell for OneToThree",
  "scripts": {
    "sync": "npx cap sync android",
    "sync:ios": "npx cap sync ios",
    "copy": "npx cap copy android",
    "copy:ios": "npx cap copy ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "add:ios": "npx cap add ios",
    "build:debug": "node ./scripts/run-gradle.mjs assembleDebug",
    "build:release": "node ./scripts/run-gradle.mjs assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
