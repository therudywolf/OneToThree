{
  "name": "project-13-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "setup": "node scripts/bootstrap.js",
    "dev": "npm run dev -w client",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "build:client:export": "npm run build:export -w project-13-client",
    "build:client:export:env": "npm run build:export:env -w project-13-client",
    "lite": "node scripts/lite/install.mjs",
    "lite:gui": "node scripts/lite/wizard/server.mjs",
    "android:clean": "node -e \"const{rmSync}=require('node:fs');for(const p of ['client/out','client/.next'])rmSync(p,{recursive:true,force:true})\"",
    "android:sync": "npm run android:clean && npm run build:client:export && npm run sync --prefix mobile/capacitor",
    "android:open": "npm run open:android --prefix mobile/capacitor",
    "android:build:debug": "npm run android:sync && npm run build:debug --prefix mobile/capacitor",
    "android:build:release": "npm run android:sync && npm run build:release --prefix mobile/capacitor",
    "ios:add": "npm run add:ios --prefix mobile/capacitor",
    "ios:sync": "npm run android:clean && npm run build:client:export && npm run sync:ios --prefix mobile/capacitor",
    "ios:open": "npm run open:ios --prefix mobile/capacitor",
    "build:all": "npm run build --workspaces --if-present",
    "lint": "npm run lint -w project-13-client && npm run lint -w project-13-server",
    "prod:start": "npm run docker:up",
    "test:server": "npm run test -w project-13-server",
    "test:unit:client": "npm run test:unit -w project-13-client",
    "test:e2e": "npm run test:e2e -w project-13-client",
    "test:e2e:local": "bash ./scripts/e2e-local.sh",
    "test:e2e:live": "node scripts/e2e-live/run.mjs",
    "test:lite": "node --test \"scripts/lite/**/*.test.mjs\"",
    "test:scripts": "node --test \"scripts/lib/**/*.test.mjs\"",
    "test:desktop": "node --test \"desktop/tauri/scripts/**/*.test.mjs\"",
    "test:mobile": "node --test \"mobile/capacitor/scripts/**/*.test.mjs\"",
    "test:p0:auth": "bash ./scripts/p0-auth-suite.sh",
    "test:stages:all": "bash ./scripts/stage-all-suite.sh",
    "test:all": "npm run typecheck && npm run lint && npm run test:lite && npm run test:scripts && npm run test:desktop && npm run test:mobile && npm run test:server && npm run test:unit:client && npm run test:e2e",
    "audit:security": "node scripts/audit-security-lint.mjs",
    "audit:security:strict": "cross-env STRICT=1 node scripts/audit-security-lint.mjs",
    "review:security-pdf": "node scripts/print-security-review.mjs",
    "docker:up": "docker compose up --build",
    "docker:up:d": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "db:generate": "node ./node_modules/drizzle-kit/bin.cjs generate --config drizzle.config.ts",
    "db:push": "node ./node_modules/drizzle-kit/bin.cjs push --config drizzle.config.ts",
    "db:push:docker": "node --env-file=docker.db.env ./node_modules/drizzle-kit/bin.cjs push --config drizzle.config.ts",
    "db:studio": "node ./node_modules/drizzle-kit/bin.cjs studio --config drizzle.config.ts",
    "typecheck": "npm run typecheck -w project-13-client && npm run typecheck -w project-13-server",
    "check:locales": "node scripts/check-locale-keys.mjs",
    "check:drizzle": "node scripts/check-drizzle-journal.mjs",
    "backup": "npx tsx scripts/backup.ts",
    "cors:smoke": "node scripts/cors-preflight-smoke.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "client/src/**/*.{ts,tsx}": "npm run lint -w project-13-client -- --fix",
    "client/tests/**/*.ts": "npm run lint -w project-13-client -- --fix",
    "server/src/**/*.ts": "npm run lint -w project-13-server -- --fix",
    "client/src/locales/*.{ts,tsx}": "npm run check:locales"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.8.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "glob": "^10.4.6",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.23",
    "protobufjs": "^7.6.5",
    "ws": "^8.21.0",
    "minimatch@10": {
      "brace-expansion": "^5.0.8"
    },
    "uuid": "^14.0.0",
    "@tootallnate/once": "^3.0.1",
    "tar": "^7.5.19",
    "websocket-driver": "^0.7.5",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.0",
    "sharp": "^0.35.0",
    "dompurify": "^3.4.13",
    "nanoid": "^3.3.18"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  }
}
