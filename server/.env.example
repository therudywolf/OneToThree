# Project 13 (One to Three) — copy to server/.env (npm run setup does this)

DATABASE_URL=postgres://forest:forest@localhost:5432/forest
JWT_SECRET=change-me-in-production
WEBHOOK_SECRET=

# Comma-separated browser origins. In production must list explicit HTTPS origins (never *).
CORS_ORIGIN=http://localhost:3000

# /api/auth/challenge + /api/auth/verify — per-IP rate limit
AUTH_CHALLENGE_RATE_LIMIT_MAX=30
AUTH_CHALLENGE_RATE_LIMIT_WINDOW=1 minute

# 1 behind Caddy/nginx so logs and rate limits see real client IPs (default ON in production builds)
TRUST_PROXY=0

# Optional: force Secure cookies outside production (e.g. HTTPS on localhost)
# COOKIE_SECURE=0

# When the UI and API are sibling hosts (e.g. app.example.com + api.example.com), set the
# parent site so Set-Cookie uses Domain=.example.com (leading dot). Omit for single-host dev.
# COOKIE_DOMAIN=.example.com

# MinIO (local: http://localhost:9000). Presigned URLs for browsers use MINIO_PUBLIC_URL when set.
MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_PUBLIC_URL=https://s3.example.com
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_secret_change_me
MINIO_BUCKET=project13-media
# Optional: separate bucket for profile avatars (defaults to MINIO_BUCKET)
# MINIO_BUCKET_AVATARS=project13-avatars

# Redis URL — required for multi-instance deployments and Stage 2 denylist/TOTP/challenge persistence.
# docker-compose sets this automatically (redis://redis:6379).
# For local dev without Docker: start Redis locally and set below.
REDIS_URL=redis://127.0.0.1:6379

# Web Push (same public key as NEXT_PUBLIC_VAPID_PUBLIC_KEY on the client)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Optional TURN server credentials for WebRTC NAT traversal
# If set, the backend will return these values from /api/turn for authenticated clients.
# Supports: TURN_URL, TURN_USERNAME/TURN_USER, TURN_PASSWORD/TURN_SECRET/TURN_CREDENTIAL
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
